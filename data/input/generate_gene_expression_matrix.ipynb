import pandas as pd
import numpy as np
import glob
import os
from tqdm import tqdm
from functools import reduce

# Function to parse GTF attributes column into a dictionary
def parse_attributes(attr_str):
  attrs = {}
  for attr in attr_str.strip().split(';'):
    if attr.strip() == '':
      continue
    key, value = attr.strip().split(' ', 1)
    attrs[key] = value.strip('"')
  return attrs

gtf_file = r"C:\Users\winne\Documents\Caltech\ParkinsonsPaper\gencode.vM36.primary_ass
gtf = pd.read_csv(gtf_file, sep='\t', comment='#', header=None,
names=['seqname', 'source', 'feature', 'start', 'end','score', 'strand', 'frame', 'attribute'])
genes = gtf[gtf['feature'] == 'gene'].copy()
attr_dicts = genes['attribute'].apply(parse_attributes)
attr_df = pd.json_normalize(attr_dicts)
result = pd.concat([genes[['seqname', 'start', 'end', 'strand']],attr_df[['gene_id', 'gene_name', 'gene_type']]], axis=1)
result = result.sort_values(by=['seqname', 'start'])

folder = r"C:\Users\winne\Documents\Caltech\ParkinsonsPaper\AllFeatureCounts"
files = glob.glob(os.path.join(folder, "*.counts.txt"))
dfs = []
for file in tqdm(files, desc="Processing count files"):
  sample_name = os.path.basename(file).replace(".counts.txt", "")
  df = pd.read_csv(file, sep='\t', comment='#', header=None)
  gene_col = 0
  count_col = df.columns[-1]
  # Rename columns
  df = df[[gene_col, count_col]]
  df.columns = ['GeneID', sample_name]
  dfs.append(df)

# Merge on GeneID
merged_df = reduce(lambda left, right: pd.merge(left, right, on='GeneID', how='outer')
merged_df = merged_df.sort_values(by='GeneID')
if not merged_df.iloc[-1]['GeneID'].startswith("ENSM"):
  merged_df = merged_df.iloc[:-1]
merged_df = merged_df.rename(columns={'GeneID': 'gene_id'})

annotation_file = r"C:\Users\winne\Documents\Caltech\ParkinsonsPaper\Mouse_GRCm39_Gene ############## THIS LINE
annotation_df = pd.read_csv(annotation_file)[['gene_id', 'gene_name','gene_type']].drop ############## THIS LINE

# Merge in gene_name
merged_df = annotation_df.merge(merged_df, on='gene_id', how='right')

